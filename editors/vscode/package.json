{
  "name": "renew-language",
  "displayName": "Renew",
  "description": "Syntax highlighting for the Renew language. This folder is for a local VS Code or TextMate install. It is not on the marketplace.",
  "version": "1.7.0",
  "author": "John Khan",
  "license": "MIT",
  "private": true,
  "engines": { "vscode": "^1.74.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "renew",
        "aliases": ["Renew"],
        "extensions": [".renew"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "renew",
        "scopeName": "source.renew",
        "path": "./syntaxes/renew.tmLanguage.json"
      }
    ]
  }
}
